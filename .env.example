# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL: existing Banglarbhumi/DMS database. No migrations are run.
DB_NAME=banglarbhumi
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=192.168.56.61
DB_PORT=5432
DB_SCHEMA=public

# FileServerApp base URL, including its servlet context path.
FILESERVER_BASE_URL=http://192.168.56.61:3543/DocumentManagementSystem/service
DMS_REGISTRATION_NO=DMS20260006
FILESERVER_TIMEOUT_SECONDS=30

# Path to the SAME base64-encoded AES key file used by Java documentUploadService.
# Keep this file outside Git and restrict its filesystem permissions.
DMS_AES_KEY_PATH=E:/Projects/SEMSDMS/keys/DMS20260006.key

# Java-compatible behavior: AES/CBC/PKCS5Padding (PKCS7 in Python), zero IV,
# HMAC-SHA256 over the Base64 encrypted data using the decoded AES key.
# IDN is deliberately not an API input. If metadata needs an IDN, configure a
# trusted server-side value here; leave blank to skip metadata persistence safely.
DMS_METADATA_IDN=
DMS_BATCH_BENEFICIARY_MOBILE=

# Upload limit
MAX_UPLOAD_MB=30
